{
  "datasets": [
    {
      "name": "brighttv_data",
      "displayName": "BrightTV Viewer Data",
      "queryLines": [
        "SELECT\n",
        "  CAST(\n",
        "    split(\n",
        "      `subs;month_id;watch_date;day_name;day_classification;month_name;Tv_channel;watch_time;hour_of_day;time_of_day;screen_time_bucket;duration;Province;Age;Email;Social Media Handle;Race;Gender`,\n",
        "      ';'\n",
        "    )[0] AS BIGINT\n",
        "  ) AS subs,\n",
        "  CAST(\n",
        "    split(\n",
        "      `subs;month_id;watch_date;day_name;day_classification;month_name;Tv_channel;watch_time;hour_of_day;time_of_day;screen_time_bucket;duration;Province;Age;Email;Social Media Handle;Race;Gender`,\n",
        "      ';'\n",
        "    )[1] AS INT\n",
        "  ) AS month_id,\n",
        "  CAST(\n",
        "    split(\n",
        "      `subs;month_id;watch_date;day_name;day_classification;month_name;Tv_channel;watch_time;hour_of_day;time_of_day;screen_time_bucket;duration;Province;Age;Email;Social Media Handle;Race;Gender`,\n",
        "      ';'\n",
        "    )[2] AS DATE\n",
        "  ) AS watch_date,\n",
        "  split(\n",
        "    `subs;month_id;watch_date;day_name;day_classification;month_name;Tv_channel;watch_time;hour_of_day;time_of_day;screen_time_bucket;duration;Province;Age;Email;Social Media Handle;Race;Gender`,\n",
        "    ';'\n",
        "  )[3] AS day_name,\n",
        "  split(\n",
        "    `subs;month_id;watch_date;day_name;day_classification;month_name;Tv_channel;watch_time;hour_of_day;time_of_day;screen_time_bucket;duration;Province;Age;Email;Social Media Handle;Race;Gender`,\n",
        "    ';'\n",
        "  )[4] AS day_classification,\n",
        "  split(\n",
        "    `subs;month_id;watch_date;day_name;day_classification;month_name;Tv_channel;watch_time;hour_of_day;time_of_day;screen_time_bucket;duration;Province;Age;Email;Social Media Handle;Race;Gender`,\n",
        "    ';'\n",
        "  )[5] AS month_name,\n",
        "  split(\n",
        "    `subs;month_id;watch_date;day_name;day_classification;month_name;Tv_channel;watch_time;hour_of_day;time_of_day;screen_time_bucket;duration;Province;Age;Email;Social Media Handle;Race;Gender`,\n",
        "    ';'\n",
        "  )[6] AS tv_channel,\n",
        "  split(\n",
        "    `subs;month_id;watch_date;day_name;day_classification;month_name;Tv_channel;watch_time;hour_of_day;time_of_day;screen_time_bucket;duration;Province;Age;Email;Social Media Handle;Race;Gender`,\n",
        "    ';'\n",
        "  )[7] AS watch_time,\n",
        "  CAST(\n",
        "    split(\n",
        "      `subs;month_id;watch_date;day_name;day_classification;month_name;Tv_channel;watch_time;hour_of_day;time_of_day;screen_time_bucket;duration;Province;Age;Email;Social Media Handle;Race;Gender`,\n",
        "      ';'\n",
        "    )[8] AS INT\n",
        "  ) AS hour_of_day,\n",
        "  split(\n",
        "    `subs;month_id;watch_date;day_name;day_classification;month_name;Tv_channel;watch_time;hour_of_day;time_of_day;screen_time_bucket;duration;Province;Age;Email;Social Media Handle;Race;Gender`,\n",
        "    ';'\n",
        "  )[9] AS time_of_day,\n",
        "  split(\n",
        "    `subs;month_id;watch_date;day_name;day_classification;month_name;Tv_channel;watch_time;hour_of_day;time_of_day;screen_time_bucket;duration;Province;Age;Email;Social Media Handle;Race;Gender`,\n",
        "    ';'\n",
        "  )[10] AS screen_time_bucket,\n",
        "  split(\n",
        "    `subs;month_id;watch_date;day_name;day_classification;month_name;Tv_channel;watch_time;hour_of_day;time_of_day;screen_time_bucket;duration;Province;Age;Email;Social Media Handle;Race;Gender`,\n",
        "    ';'\n",
        "  )[11] AS duration,\n",
        "  split(\n",
        "    `subs;month_id;watch_date;day_name;day_classification;month_name;Tv_channel;watch_time;hour_of_day;time_of_day;screen_time_bucket;duration;Province;Age;Email;Social Media Handle;Race;Gender`,\n",
        "    ';'\n",
        "  )[12] AS province,\n",
        "  CAST(\n",
        "    split(\n",
        "      `subs;month_id;watch_date;day_name;day_classification;month_name;Tv_channel;watch_time;hour_of_day;time_of_day;screen_time_bucket;duration;Province;Age;Email;Social Media Handle;Race;Gender`,\n",
        "      ';'\n",
        "    )[13] AS INT\n",
        "  ) AS age,\n",
        "  split(\n",
        "    `subs;month_id;watch_date;day_name;day_classification;month_name;Tv_channel;watch_time;hour_of_day;time_of_day;screen_time_bucket;duration;Province;Age;Email;Social Media Handle;Race;Gender`,\n",
        "    ';'\n",
        "  )[14] AS email,\n",
        "  split(\n",
        "    `subs;month_id;watch_date;day_name;day_classification;month_name;Tv_channel;watch_time;hour_of_day;time_of_day;screen_time_bucket;duration;Province;Age;Email;Social Media Handle;Race;Gender`,\n",
        "    ';'\n",
        "  )[15] AS social_media_handle,\n",
        "  split(\n",
        "    `subs;month_id;watch_date;day_name;day_classification;month_name;Tv_channel;watch_time;hour_of_day;time_of_day;screen_time_bucket;duration;Province;Age;Email;Social Media Handle;Race;Gender`,\n",
        "    ';'\n",
        "  )[16] AS race,\n",
        "  split(\n",
        "    `subs;month_id;watch_date;day_name;day_classification;month_name;Tv_channel;watch_time;hour_of_day;time_of_day;screen_time_bucket;duration;Province;Age;Email;Social Media Handle;Race;Gender`,\n",
        "    ';'\n",
        "  )[17] AS gender\n",
        "FROM\n",
        "  workspace.default.brighttv_viewer_data\n",
        "WHERE\n",
        "  `subs;month_id;watch_date;day_name;day_classification;month_name;Tv_channel;watch_time;hour_of_day;time_of_day;screen_time_bucket;duration;Province;Age;Email;Social Media Handle;Race;Gender`\n",
        "    != 'subs;month_id;watch_date;day_name;day_classification;month_name;Tv_channel;watch_time;hour_of_day;time_of_day;screen_time_bucket;duration;Province;Age;Email;Social Media Handle;Race;Gender'"
      ]
    }
  ],
